{
  "name": "litegraph-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm -r test",
    "size": "node scripts/size-report.mjs",
    "verify-umd": "node scripts/verify-umd.mjs",
    "verify-pack": "node scripts/verify-pack.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:serve": "vitepress serve docs",
    "remove": "npm run remove:dist && npm run remove:module",
    "remove:dist": "rm -rf packages/**/dist",
    "remove:module": "rm -rf packages/**/node_modules",
    "nullcheck": "node scripts/nullcheck.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.74.0",
    "vitepress": "^1.4.3"
  }
}
