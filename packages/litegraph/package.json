{
  "name": "@gausszhou/litegraph",
  "version": "0.1.0",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "directories": {
    "doc": "doc"
  },
  "private": false,
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -p tsconfig.json --emitDeclarationOnly --declaration --outDir dist && node ../../scripts/copy-file.mjs ../core/src/css/litegraph.css dist/style.css",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "author": "Gauss Zhou <gausszhou@qq.com>",
  "license": "MIT",
  "dependencies": {
    "@gausszhou/litegraph-core": "workspace:*",
    "@gausszhou/litegraph-nodes-audio": "workspace:*",
    "@gausszhou/litegraph-nodes-basic": "workspace:*",
    "@gausszhou/litegraph-nodes-events": "workspace:*",
    "@gausszhou/litegraph-nodes-graphics": "workspace:*",
    "@gausszhou/litegraph-nodes-input": "workspace:*",
    "@gausszhou/litegraph-nodes-logic": "workspace:*",
    "@gausszhou/litegraph-nodes-math": "workspace:*",
    "@gausszhou/litegraph-nodes-midi": "workspace:*",
    "@gausszhou/litegraph-nodes-strings": "workspace:*",
    "@gausszhou/litegraph-nodes-widget": "workspace:*",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.3",
    "vite": "^4.2.1"
  },
  "type": "module",
  "homepage": "https://gausszhou.github.io/litegraph/docs",
  "bugs": {
    "url": "https://github.com/gausszhou/litegraph/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gausszhou/litegraph.git",
    "directory": "packages/litegraph"
  },
  "files": [
    "dist"
  ],
  "module": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "description": "LiteGraph all-in-one bundle: core engine plus every built-in node pack",
  "keywords": [
    "litegraph",
    "node-editor",
    "node-graph",
    "canvas",
    "blueprints",
    "graph"
  ],
  "sideEffects": true,
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "require": "./dist/index.umd.cjs"
      },
      "./style.css": "./dist/style.css",
      "./package.json": "./package.json"
    }
  }
}
